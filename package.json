{
  "name": "mass-cac-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MASS Children’s Activity Centres integrated frontend prototype",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint src scripts --max-warnings=0",
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/frontend/*.test.mjs && node tests/entry-workflows.mjs",
    "test:api": "bash tests/frontend/run-database.sh",
    "test:browser": "MASS_RELEASE_BROWSER=1 bash tests/release/run-local.sh",
    "test:directory": "python tests/directory/reconcile_test.py && bash tests/directory/run-local.sh",
    "test:imports": "bash tests/imports/run-local.sh",
    "test:students": "python tests/students/test_staging.py && bash tests/students/run-local.sh && bash tests/students/run-current-core.sh",
    "check:preview": "node scripts/preview-config.mjs",
    "test:activation": "python -m unittest discover -s tests/activation -p 'test_*.py' && node tests/activation/provider-rehearsal.mjs",
    "test:sql:portable": "node tests/release/portable-sql.mjs",
    "test:cleanup": "node tests/maintenance/attendance-cleanup.mjs",
    "test:attendance": "node tests/attendance/register.mjs && node tests/attendance/metadata.mjs && node tests/attendance/feedback.mjs && node tests/attendance/swapneel-review.mjs",
    "test:attendance:browser": "node tests/attendance/browser.mjs",
    "test:centre-events": "node tests/centre-events/register.mjs",
    "test:staff-access": "node tests/attendance/staff-access.mjs",
    "perf:overview": "node scripts/perf/overview-waterfall.mjs",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "MASS_NEXT_UI=1 node scripts/build.mjs",
    "web:typecheck": "tsc -p web/tsconfig.json",
    "test:web": "vitest run --config web/vite.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.55.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
