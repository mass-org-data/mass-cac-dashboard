{
  "name": "mass-cac-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MASS Children\u2019s Activity Centres integrated frontend prototype",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
